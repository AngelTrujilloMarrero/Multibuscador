# Puerto del servidor Express (por defecto 8787)
PORT=8787

# ------------------------------------------------------------------
# Caché compartida (opcional pero muy recomendable en Vercel)
# ------------------------------------------------------------------
# Con una caché compartida, una sola petición a las tiendas sirve a todos
# los usuarios. Es lo que evita que el volumen de consultas dispare los
# bloqueos anti-bot de Alcampo (AWS WAF) y Leroy Merlin (DataDome).
#
# Vercel KV (Storage > KV) o Upstash Redis:
#   KV_REST_API_URL=https://xxx.kv.vercel-storage.com
#   KV_REST_API_TOKEN=tu-token
# (o bien UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
#
# Tiempo de vida de la caché de búsquedas, en segundos (por defecto 600)
# CACHE_TTL_SECONDS=600

# ------------------------------------------------------------------
# Proxy de scraping (opcional)
# ------------------------------------------------------------------
# Alcampo (AWS WAF) y Leroy Merlin (DataDome) bloquean el acceso
# automatizado según la IP de salida. Con una de estas variables, todas
# las peticiones a las tiendas pasan por el proxy y se evitan los bloqueos.
#
# Opción A: pega la clave de un servicio y listo (recomendado).
#   SCRAPER_API_KEY=tu-clave-scraperapi
#   ZYTE_API_KEY=tu-clave-zyte
#   SCRAPINGBEE_API_KEY=tu-clave-scrapingbee
#
# Opción B: solo enrutar por el proxy las tiendas bloqueadas y dejar el
#           resto en directo (ahorra créditos del proxy):
#   PROXY_STORES=alcampo,leroy-merlin
#
# Opción B: plantilla propia (tiene prioridad sobre las de arriba).
#   {url} = URL codificada, {url_raw} = URL literal, {api_key} = PROXY_API_KEY.
#   PROXY_URL_TEMPLATE=https://api.scraperapi.com?api_key={api_key}&url={url}
#   PROXY_API_KEY=tu-clave
#
# Opción C: proxy propio en tu casa o en un servidor.
#   PROXY_URL_TEMPLATE=http://192.168.1.50:8789/?url={url_raw}
#
# Extra:
#   SCRAPER_RENDER_JS=true   # ScraperAPI con navegador real (solve WAF/captcha)
#   PROXY_HEADERS={"authorization":"Bearer token"}

# Puerto del servidor Express (por defecto 8787)
PORT=8787

# ------------------------------------------------------------------
# Frontend (Vite) y CORS
# ------------------------------------------------------------------
# URL de la API a la que llama el navegador. Vacío = mismo dominio (el
# servidor local de Express). Ponla si la API vive en otra máquina o con un
# túnel:
#   VITE_API_URL=http://localhost:8787
#
# Orígenes permitidos por CORS (la API). Por defecto solo localhost.
# ALLOWED_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------
# Proxy de scraping: una variable por tienda protegida
# ------------------------------------------------------------------
# Solo dos variables, una para Alcampo y otra para Leroy Merlin (las otras
# cinco tiendas no pasan por proxy). El valor puede ser:
#   - la clave de un servicio de proxy (ScraperAPI por defecto), o
#   - la URL completa de tu propio proxy (con {url} o sin ella).
#
#   ALCAMPO_PROXY=clave-scraperapi
#   ALCAMPO_PROXY=https://api.scraperapi.com?api_key=CLAVE&url={url}
#   ALCAMPO_PROXY=https://mi-proxy.example/?token=SEGRETO
#
#   LEROY_MERLIN_PROXY=clave-scraperapi
#   LEROY_MERLIN_PROXY=https://api.scraperapi.com?api_key=CLAVE&url={url}
#
# Si no se definen, esas tiendas se consultan directamente (y puede que
# muestren el aviso de bloqueo anti-bot).

# ------------------------------------------------------------------
# Caché compartida (opcional, solo si usas Upstash/Redis)
# ------------------------------------------------------------------
#   KV_REST_API_URL
#   KV_REST_API_TOKEN
# Con Upstash: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
#
# Tiempo de vida de la caché de búsquedas, en segundos (por defecto 600)
# CACHE_TTL_SECONDS=600

# Puerto del servidor Express (por defecto 8787)
PORT=8787

# ------------------------------------------------------------------
# Proxy de scraping (opcional)
# ------------------------------------------------------------------
# Alcampo (AWS WAF) y Leroy Merlin (DataDome) bloquean el acceso
# automatizado según la IP de salida. Si defines estas variables, todas
# las peticiones a las tiendas pasan por el proxy y se evitan esos bloqueos.
#
# Plantilla de URL: {url} = URL codificada, {url_raw} = URL literal,
# {api_key} = valor de PROXY_API_KEY.
#
# Ejemplos:
#   PROXY_URL_TEMPLATE=https://api.scraperapi.com?api_key={api_key}&url={url}
#   PROXY_URL_TEMPLATE=https://api.scraperapi.com?api_key={api_key}&url={url}&render_js=true
#   PROXY_URL_TEMPLATE=https://tu-proxy.example/?url={url_raw}
# PROXY_URL_TEMPLATE=
# PROXY_API_KEY=
# Cabeceras adicionales para el proxy (JSON)
# PROXY_HEADERS={"authorization":"Bearer token"}
